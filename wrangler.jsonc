{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixpro-r2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/i/*", "/static/*", "/health"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pixpro-images"
    }
  ],
  "vars": {
    "MAX_UPLOAD_MB": "10"
  }
}
